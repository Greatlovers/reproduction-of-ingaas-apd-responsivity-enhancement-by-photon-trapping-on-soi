; Shao 2025 Figs.4/7, 2D three-hole electrical section, X=x, Y=-z (um).
; Same nominal epilayer thicknesses as audited parent; substrate is DC-passive.
(sde:clear)
(sdegeo:set-auto-region-naming OFF)
(sdegeo:set-default-boolean "ABA")
(define kind "@Geometry@")
(define f @MeshFactor@)
(define nc @Ncharge@)
(define a 0.625)
(define r 0.250)
(define h 0.220)
(define d (if (string=? kind "Cylinder") 0.0 0.080))
(define xl -0.9375)
(define xr 0.9375)
(define centers (list (- a) 0.0 a))
(define (p x z) (position x (- z) 0))
(define (rect z0 z1 mat name) (sdegeo:create-rectangle (p xl z1) (p xr z0) mat name))
(define (dop name field value region)
  (sdedr:define-constant-profile name field value)
  (sdedr:define-constant-profile-region (string-append name "Place") name region))
(rect -0.300 0.000 "SU8" "R.SU8Bond")
(rect 0.000 0.100 "InGaAs" "R.PContact")
(rect 0.100 0.350 "InGaAs" "R.Absorber")
(do ((k 0 (+ k 1))) ((= k 8))
  (define name (string-append "R.Grading" (number->string k)))
  (define s (/ (+ k 0.5) 8.0))
  (rect (+ 0.350 (* 0.050 (/ k 8.0))) (+ 0.350 (* 0.050 (/ (+ k 1) 8.0))) "AlInGaAs" name)
  (dop (string-append "GradeX" (number->string k)) "xMoleFraction" (* 0.48 s) name)
  (dop (string-append "GradeY" (number->string k)) "yMoleFraction" (- 0.53 (* 0.01 s)) name))
(rect 0.400 0.450 "InAlAs" "R.Charge")
(rect 0.450 0.650 "InAlAs" "R.Multiplier")
(rect 0.650 0.700 "InGaAs" "R.NContact")
(rect 0.700 0.800 "SU8" "R.SU8Clad")
(if (not (string=? kind "Control"))
  (do ((k 0 (+ k 1))) ((= k 3))
    (define c (list-ref centers k))
    (sdegeo:create-polygon (list (p (- c r) 0) (p (+ c r) 0) (p (+ c (- r d)) h) (p (- c (- r d)) h)) "SU8" (string-append "R.PTHole" (number->string k)))))
; Material-wide dopants persist on all disconnected p++ islands.
(sdedr:define-constant-profile "MoleGa" "xMoleFraction" 0.47)
(sdedr:define-constant-profile-material "GaPlace" "MoleGa" "InGaAs")
(sdedr:define-constant-profile "MoleAl" "xMoleFraction" 0.48)
(sdedr:define-constant-profile-material "AlPlace" "MoleAl" "InAlAs")
; Spatial windows keep p++ profiles defined after boolean splitting.
(sdedr:define-refeval-window "PWindow" "Rectangle" (p xl 0.1) (p xr 0))
(sdedr:define-constant-profile "PDoping" "BoronActiveConcentration" 5e18)
(sdedr:define-constant-profile-placement "PPlace" "PDoping" "PWindow")
(dop "NDoping" "ArsenicActiveConcentration" 5e18 "R.NContact")
(dop "ChargeDoping" "BoronActiveConcentration" nc "R.Charge")
(sdegeo:define-contact-set "anode" 4 (color:rgb 1 0 0) "##")
(sdegeo:define-contact-set "cathode" 4 (color:rgb 0 0 1) "##")
(sdegeo:set-contact (find-edge-id (p 0 0.700)) "cathode")
(if (string=? kind "Control")
  (sdegeo:set-contact (find-edge-id (p 0 0)) "anode")
  (do ((k 0 (+ k 1))) ((= k 4))
    (define left (if (= k 0) xl (+ (list-ref centers (- k 1)) r)))
    (define right (if (= k 3) xr (- (list-ref centers k) r)))
    (sdegeo:set-contact (find-edge-id (p (* 0.5 (+ left right)) 0)) "anode")))
(if (not (null? (sdegeo:check-overlap (get-body-list) #f))) (error 'Shao47 "Geometry overlap"))
(sdedr:define-refeval-window "All" "Rectangle" (p xl 0.8) (p xr -0.3))
(sdedr:define-refinement-size "AllRef" (* f 0.08) (* f 0.04) (* f 0.008) (* f 0.003))
(sdedr:define-refinement-placement "AllPlace" "AllRef" "All")
(sdedr:define-refinement-function "AllRef" "MaxLenInt" "InGaAs" "SU8" (* f 0.015) 1.8 "DoubleSide")
(sdedr:define-refinement-region "PRefPlace" "AllRef" "R.PContact")
(sdedr:define-refinement-size "NRef" (* f 0.06) (* f 0.005) (* f 0.01) (* f 0.0015))
(sdedr:define-refinement-region "NRefPlace" "NRef" "R.NContact")
(do ((k 0 (+ k 1))) ((= k 8))
  (define name (string-append "R.Grading" (number->string k)))
  (define ref (string-append "GradeRef" (number->string k)))
  (sdedr:define-refinement-size ref (* f 0.060) 0.00625 (* f 0.020) 0.00625)
  (sdedr:define-refinement-region (string-append ref "Place") ref name))
(sdedr:define-refinement-size "ChargeRef" (* f 0.060) (* f 0.005) (* f 0.010) (* f 0.0015))
(sdedr:define-refinement-region "ChargeRefPlace" "ChargeRef" "R.Charge")
(sdedr:define-refinement-size "MultiplierRef" (* f 0.060) (* f 0.010) (* f 0.010) (* f 0.002))
(sdedr:define-refinement-region "MultiplierRefPlace" "MultiplierRef" "R.Multiplier")
(sde:save-model "n@node@")
(if (not (sde:build-mesh "n@node@")) (error 'Shao47 "Mesh generation failed"))
(display "SHAO_FIG47_GEOMETRY_AND_MESH_COMPLETED")(newline)
