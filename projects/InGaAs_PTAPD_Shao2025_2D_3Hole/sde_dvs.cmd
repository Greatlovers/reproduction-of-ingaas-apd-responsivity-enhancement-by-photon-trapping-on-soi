; Shao et al., TED 2025, DOI 10.1109/TED.2025.3544972
; TWO-DIMENSIONAL THREE-HOLE SECTION ONLY. Units: um, cm^-3.
; See model_basis.json for published values, figure estimates and assumptions.
; X = paper x, Y = paper z; out-of-plane direction is not modeled.
(sde:clear)
(sdegeo:set-auto-region-naming OFF)
(sdegeo:set-default-boolean "ABA")
(define a (* 0.001 @a_nm@))
(define r (* 0.001 @r_nm@))
(define h (* 0.001 @h_nm@))
(define D (* 0.001 @D_nm@))
(define Tp (* 0.001 @Tp_nm@))
(define Ta (* 0.001 @Ta_nm@))
(define Tg (* 0.001 @Tg_nm@))
(define Tc (* 0.001 @Tc_nm@))
(define Tm (* 0.001 @Tm_nm@))
(define Tn (* 0.001 @Tn_nm@))
(define Tb (* 0.001 @Tbond_nm@))
(define Tsi (* 0.001 @Tsi_nm@))
(define Tbox (* 0.001 @Tbox_nm@))
(define Tsub (* 0.001 @Tsub_nm@))
(define Ttop (* 0.001 @Tclad_nm@))
(define Np @NAp@)
(define Nc @NAc@)
(define Nn @NDn@)
(define W (* 3.0 a))
(define xl (* -0.5 W))
(define xr (* 0.5 W))
(define ya Tp)
(define yg (+ ya Ta))
(define yc (+ yg Tg))
(define ym (+ yc Tc))
(define yn (+ ym Tm))
(define yt (+ yn Tn))
(define ybottom (- (+ Tb Tsi Tbox Tsub)))
(define centers (list (- a) 0.0 a))
(define (radius-at y) (- r (* D (/ y h))))
(if (or (>= (* 2.0 r) a) (<= (- r D) 0.0) (<= h Tp) (>= h yg))
    (error 'Shao2D "Invalid three-hole geometry: holes overlap or reach grading layer"))
(define (rect x0 y0 x1 y1 material name)
  (sdegeo:create-rectangle (position x0 y0 0) (position x1 y1 0) material name))
(rect xl ybottom xr (- (+ Tb Tsi Tbox)) "Silicon" "R.HandleSi")
(rect xl (- (+ Tb Tsi Tbox)) xr (- (+ Tb Tsi)) "Oxide" "R.BOX")
(rect xl (- (+ Tb Tsi)) xr (- Tb) "Silicon" "R.SOISi")
(rect xl (- Tb) xr 0.0 "SU8" "R.SU8Bond")
(sdedr:define-constant-profile "MoleInGaAs" "xMoleFraction" 0.47)
; Explicitly partition the p++ contact into four islands so region-local
; doping remains defined after three holes interrupt the bottom contact layer.
(define (p-island k)
  (define left0 (if (= k 0) xl (+ (list-ref centers (- k 1)) r)))
  (define left1 (if (= k 0) xl (+ (list-ref centers (- k 1)) (radius-at Tp))))
  (define right0 (if (= k 3) xr (- (list-ref centers k) r)))
  (define right1 (if (= k 3) xr (- (list-ref centers k) (radius-at Tp))))
  (define name (string-append "R.PContact" (number->string k)))
  (sdegeo:create-polygon (list (position left0 0 0) (position right0 0 0)
                              (position right1 Tp 0) (position left1 Tp 0)) "InGaAs" name)
  (sdedr:define-constant-profile (string-append "P" (number->string k)) "BoronActiveConcentration" Np)
  (sdedr:define-constant-profile-region (string-append "PPlace" (number->string k)) (string-append "P" (number->string k)) name)
  (sdedr:define-constant-profile-region (string-append "PMole" (number->string k)) "MoleInGaAs" name))
(do ((k 0 (+ k 1))) ((= k 4)) (p-island k))
(rect xl ya xr yg "InGaAs" "R.Absorber")
(sdedr:define-constant-profile-region "AbsMole" "MoleInGaAs" "R.Absorber")
; Eight region-local composition steps approximate intrinsic AlInGaAs grading.
; DATEX convention: Al(x)In(y)Ga(1-x-y)As, not InGaAs' Ga fraction.
(define Ng 8)
(do ((k 0 (+ k 1))) ((= k Ng))
  (define s (/ (+ k 0.5) Ng))
  (define name (string-append "R.Grading" (number->string k)))
  (define px (string-append "Gx" (number->string k)))
  (define py (string-append "Gy" (number->string k)))
  (rect xl (+ yg (* Tg (/ k Ng))) xr (+ yg (* Tg (/ (+ k 1) Ng))) "AlInGaAs" name)
  (sdedr:define-constant-profile px "xMoleFraction" (* 0.48 s))
  (sdedr:define-constant-profile py "yMoleFraction" (- 0.53 (* 0.01 s)))
  (sdedr:define-constant-profile-region (string-append px "Place") px name)
  (sdedr:define-constant-profile-region (string-append py "Place") py name))
(rect xl yc xr ym "InAlAs" "R.Charge")
(rect xl ym xr yn "InAlAs" "R.Multiplier")
(rect xl yn xr yt "InGaAs" "R.NContact")
(sdedr:define-constant-profile "ChargeP" "BoronActiveConcentration" Nc)
(sdedr:define-constant-profile-region "ChargePlace" "ChargeP" "R.Charge")
(sdedr:define-constant-profile "ContactN" "ArsenicActiveConcentration" Nn)
(sdedr:define-constant-profile-region "ContactNPlace" "ContactN" "R.NContact")
(sdedr:define-constant-profile "MoleInAlAs" "xMoleFraction" 0.48)
(sdedr:define-constant-profile-region "ChargeMole" "MoleInAlAs" "R.Charge")
(sdedr:define-constant-profile-region "MultMole" "MoleInAlAs" "R.Multiplier")
(sdedr:define-constant-profile-region "NMole" "MoleInGaAs" "R.NContact")
(rect xl yt xr (+ yt Ttop) "SU8" "R.SU8Clad")
; SU8-filled reverse-placed trapezoids: 500 nm bottom, 340 nm top.
(do ((k 0 (+ k 1))) ((= k 3))
  (define cx (list-ref centers k))
  (sdegeo:create-polygon
    (list (position (- cx r) 0 0) (position (+ cx r) 0 0)
          (position (+ cx (- r D)) h 0) (position (- cx (- r D)) h 0))
    "SU8" (string-append "R.PTHole" (number->string k))))
; Equivalent terminal planes; fabricated metal pads/rings are not specified
; by the paper and are not represented by these boundary contacts.
(sdegeo:define-contact-set "anode" 4 (color:rgb 1 0 0) "##")
(sdegeo:define-contact-set "cathode" 4 (color:rgb 0 0 1) "##")
(sdegeo:set-contact (find-edge-id (position 0 yt 0)) "cathode")
(do ((k 0 (+ k 1))) ((= k 4))
  (define left (if (= k 0) xl (+ (list-ref centers (- k 1)) r)))
  (define right (if (= k 3) xr (- (list-ref centers k) r)))
  (sdegeo:set-contact (find-edge-id (position (* 0.5 (+ left right)) 0 0)) "anode"))
(if (not (null? (sdegeo:check-overlap (get-body-list) #f))) (error 'Shao2D "Geometry overlap found"))
; Internal semiconductor/SU8 interfaces have one ACIS edge per material.
; Four physical p segments therefore have 8 edge entities; one n segment has 2.
; The native mesh audit checks the unique segments and semiconductor neighbors.
(if (not (= (length (sdegeo:get-contact-edgelist "anode")) 8)) (error 'Shao2D "Four paired p-contact segments required"))
(if (not (= (length (sdegeo:get-contact-edgelist "cathode")) 2)) (error 'Shao2D "One paired n-contact segment required"))
; Coarse SOI scaffold; fine layers, junctions and hole edges.
(sdedr:define-refeval-window "Win.Global" "Rectangle" (position xl ybottom 0) (position xr (+ yt Ttop) 0))
(sdedr:define-refinement-size "Ref.Global" 0.25 0.25 0.020 0.0125)
(sdedr:define-refinement-placement "Place.Global" "Ref.Global" "Win.Global")
(sdedr:define-refeval-window "Win.Epi" "Rectangle" (position xl 0 0) (position xr yt 0))
(sdedr:define-refinement-size "Ref.Epi" 0.075 0.040 0.012 0.010)
; Doping is region-constant and the mesh already conforms to every junction.
; Avoid MaxTransDiff refinement across ideal abrupt doping jumps.
(sdedr:define-refinement-function "Ref.Epi" "MaxLenInt" "InGaAs" "SU8" 0.025 1.8 "DoubleSide")
(sdedr:define-refinement-function "Ref.Epi" "MaxLenInt" "InAlAs" "AlInGaAs" 0.030 1.8 "DoubleSide")
(sdedr:define-refinement-placement "Place.Epi" "Ref.Epi" "Win.Epi")
(do ((k 0 (+ k 1))) ((= k Ng))
  (define name (string-append "R.Grading" (number->string k)))
  (sdedr:define-refinement-size (string-append "RefG" (number->string k)) 0.080 0.00625 0.025 0.00625)
  (sdedr:define-refinement-region (string-append "PlaceG" (number->string k)) (string-append "RefG" (number->string k)) name))
(sde:save-model "n@node@")
(if (not (sde:build-mesh "n@node@")) (error 'Shao2D "Native mesh generation failed"))
(display "SHAO_2D_THREE_HOLE_GEOMETRY_AND_MESH_COMPLETED\n")
